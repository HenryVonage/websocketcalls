# Copy this to .env for local development (never commit the real .env).
# In Render, set these under Environment (see setup guide).

# Vonage
VONAGE_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# Paste the full PEM block as the value (Render's editor supports multi-line).
VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Alternative to the above: use a Render Secret File instead, and set:
# VONAGE_PRIVATE_KEY_PATH=/etc/secrets/private.key

# Anthropic (WhatsApp text conversation)
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs (realtime voice AI bridge — Vonage Estate Voice Assistant agent)
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=agent_9901kxh3rtnmf94anx9wb01st72f
# Optional: a second ElevenLabs agent for the Ticketing demo's "Contact us"
# voice escalation (same PSTN number, different persona/knowledge base —
# see lib/realtimeBridge.js). Create it in ElevenLabs with a Monte-Carlo
# Masters ticketing system prompt, then paste its agent_id here. Until set,
# ticketing calls fall back to the Real Estate agent above.
ELEVENLABS_TICKETING_AGENT_ID=

# Public URLs of this deployed service (used to build NCCO URLs)
PUBLIC_BASE_URL=https://websocketcalls.onrender.com
PUBLIC_WSS_BASE=wss://websocketcalls.onrender.com

# Audio sample rate used for both the NCCO content-type and the Vonage
# websocket stream. 16000 matches ElevenLabs' documented Vonage reference
# integration. See lib/nccoBuilder.js before changing this.
AUDIO_SAMPLE_RATE=16000

# Spotify (Music Lovers demo). Both flows below share one app — create it
# at https://developer.spotify.com/dashboard to get SPOTIFY_CLIENT_ID /
# SPOTIFY_CLIENT_SECRET.
#  - Client Credentials (app-only, no user login): used by
#    lib/spotifyApi.js to look up a track's preview_url for the ringtone
#    follow-up feature. Needs no further setup.
#  - Authorization Code (user-consent OAuth): used by lib/spotifyOAuth.js
#    for the "Connect your Spotify" step on music-lovers.html, reading a
#    listener's own top artists to infer their genre. Needs:
#      1. SPOTIFY_REDIRECT_URI below added VERBATIM to the app's Redirect
#         URIs in the dashboard's Settings (e.g.
#         https://websocketcalls.onrender.com/api/spotify-callback).
#      2. While the app is in Development Mode (the default), every
#         Spotify account that will test this flow must be added under the
#         dashboard's User Management tab (by email, up to 25) — otherwise
#         they see "You're not able to test this app" on Spotify's consent
#         screen.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://websocketcalls.onrender.com/api/spotify-callback

# Where /api/spotify-callback sends a listener back to after Spotify
# connect completes (or fails) — the "Connect your Spotify" page itself.
# Defaults to the live GitHub Pages URL if unset, so this only needs
# setting for local dev against a different frontend origin.
MUSIC_LOVERS_PAGE_URL=https://henryvonage.github.io/frontend/music-lovers.html
